# Variables de entorno (Railway -> servicio -> Variables). Solo las dos primeras son obligatorias.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Escaneo ----
TIMEFRAME=5m
TOP_N=5
MAX_SAME_DIR=3
MIN_SCORE=0
# 0 = analiza TODAS las monedas de BingX. MIN_LIQ_USDT = volumen 24h minimo para ENVIAR (flag 'liquid'; el resto solo se anota en el diario)
MIN_VOLUME_USDT=0
MIN_LIQ_USDT=1000000
MAX_SYMBOLS=0
INCLUDE_SYMBOLS=
EXCLUDE_SYMBOLS=
REQ_PER_SEC=25
SCAN_DELAY_SEC=4
WARMUP_BARS=1000
UNIVERSE_REFRESH_MIN=60
HEARTBEAT_HOURS=6
SIGNAL_MAX_AGE=1

# ---- Setups: smc, p7h, zone, trail ----
SETUPS=smc,p7h,zone,trail
# los que NO estan aqui solo se anotan en el diario (modo sombra)
SEND_SETUPS=smc,p7h,zone,trail
# Puertas (deben cumplirse para enviar). Maximo recomendado: 3.
# Flags: htf15 htf1h trend5 btc adx session weekday sweep sweep_htf disp strong zone range_pos rvol cost liquid
GATES=htf15,cost,liquid

# ---- SMC ----
SWING_LEN=5
ENTRY_MODE=Retest OB
OB_MITIGATION=Close through
COOLDOWN_BARS=8
SL_BUFFER_ATR=0.3
OB_MIN_AGE=1
SWEEP_LOOKBACK=30

# ---- Tendencia (trail EMA +- ATR) ----
TRAIL_MA_LEN=28
TRAIL_ATR_LEN=15
TRAIL_MULT=1.25
TRAIL_RETEST_EXPIRY=20
ADX_LEN=14
ADX_MIN=20

# ---- Zonas de liquidez ----
ZONE_SWING_LEN=12
ZONE_ATR_MULT=0.35
ZONE_MAX=8
ZONE_RETEST_EXPIRY=30
ZONE_CONF_PAD_ATR=0.25

# ---- Prev 7H + Strong Closure ----
P7H_LEVEL_PCT=25
P7H_ALIGN=day
P7H_MODES=retest
P7H_RETEST_WIN=6
P7H_SL_BUFFER_ATR=0.15
P7H_COOLDOWN=6
SC_BODY_PCT=55
SC_CLOSE_PCT=22
SC_MIN_ATR=0.9
SC_RVOL=1.25
DISP_LOOKBACK=3

# ---- Sesion (horas UTC) y rango ----
SESSION_WINDOWS=13-21
RANGE_FAV=0.5

# ---- Riesgo y objetivos ----
MAX_RISK_PCT=3.0
TP1_R=1.0
TP2_R=2.0
TP3_R=3.0
TP_BUFFER_ATR=0.1
MIN_RR=1.5
MAX_LIQ_RR=6.0
# Costes: taker 0.05% por lado en BingX perpetuos (0.10% ida y vuelta) + ~0.02% de deslizamiento
COST_PCT=0.12
MAX_COST_R=0.25
# No se envia si el precio actual ya se alejo mas de esto (en R) de la entrada
MAX_CHASE_R=0.25

# ---- Tamano de posicion (opcional: ACCOUNT_USDT=0 lo oculta) ----
ACCOUNT_USDT=0
RISK_PCT=1.0
MAX_LEVERAGE=10

# ---- Diario e informes ----
# En Railway basta con conectar un Volume al servicio: el bot usa RAILWAY_VOLUME_MOUNT_PATH solo. Sin Volume el diario se pierde al redesplegar.
# JOURNAL_PATH=/data/journal.db
JOURNAL_MAX_BARS=96
JOURNAL_KEEP_DAYS=14
REPORT_HOUR_UTC=6
REPORT_DAYS=7
