# SMC Notebook Bot - variables de entorno (en Railway: servicio -> Variables).
# Los comentarios van en su propia linea; no pongas "# nota" al final de un valor.
# Solo son obligatorias TELEGRAM_BOT_TOKEN y TELEGRAM_CHAT_ID. El resto tiene valor por defecto.

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- BingX (solo si AUTO_TRADE=true). Permisos: Lectura + Trading de Futuros. SIN retiros ----
BINGX_API_KEY=
BINGX_API_SECRET=

# ---- Modo ----
# AUTO_TRADE=true opera de verdad. Empieza con false.
AUTO_TRADE=false
# 1m, 3m, 5m, 15m, 30m, 1h
TIMEFRAME=5m

# ---- Universo ----
# Volumen 24h minimo en USDT (0 = todas las monedas)
MIN_VOLUME_USDT=1000000
# 0 = sin limite (si > 0, las N con mas volumen)
MAX_SYMBOLS=0
# Ejemplo: BTC-USDT,ETH-USDT (vacio = todas)
INCLUDE_SYMBOLS=
EXCLUDE_SYMBOLS=
REQ_PER_SEC=8
SCAN_DELAY_SEC=4
WARMUP_BARS=500
UNIVERSE_REFRESH_MIN=60
HEARTBEAT_HOURS=6

# ---- Estrategia (igual al Pine) ----
SWING_LEN=5
# Retest OB | Mitad del OB
ENTRY_MODE=Retest OB
# Close through | Wick through
OB_MITIGATION=Close through
COOLDOWN_BARS=8
SL_BUFFER_ATR=0.1
RR_TARGET=2.5
USE_LIQUIDITY_TP=true

# ---- Filtros extra (opcionales) ----
MIN_RR=1.0
# Descarta senales con SL mas lejos de X% del precio
MAX_RISK_PCT=3.0
# Exigir barrida de liquidez previa al CHOCH/MSS
REQUIRE_SWEEP=false
SWEEP_LOOKBACK=30
# Velas minimas entre la creacion del OB y la entrada
OB_MIN_AGE=0

# ---- Riesgo / ejecucion ----
# % del equity arriesgado por trade
RISK_PCT=1.0
# >0 = margen fijo por trade (ignora RISK_PCT)
FIXED_MARGIN_USDT=0
LEVERAGE=5
# Tope de margen por trade (% del equity)
MAX_MARGIN_PCT=20
MAX_POSITIONS=5
# ISOLATED | CROSSED
MARGIN_MODE=ISOLATED
